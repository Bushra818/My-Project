# انسخ هذا الملف إلى .env واملأ القيم الحقيقية — لا تضع .env في Git أبدًا

NODE_ENV=development
PORT=4000

# قاعدة البيانات (PostgreSQL + PostGIS)
DATABASE_URL=postgres://worldchaos:worldchaos@localhost:5432/worldchaos

# مفتاح توقيع الجلسات (JWT) — ولّد قيمة عشوائية طويلة، مثال:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=30d

# نطاقات الواجهة الأمامية المسموح لها بالاتصال (CORS), مفصولة بفواصل
CORS_ORIGINS=http://localhost:5173

# حدود الإغراق (Rate limiting)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_MESSAGES=8
RATE_LIMIT_MAX_DRAWINGS=4

# أقصى حجم لبيانات الرسم (base64 PNG) بالبايت
MAX_DRAWING_BYTES=1500000
