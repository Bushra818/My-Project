# انسخ إلى .env للإعدادات المحلية. لا ترفع .env إلى Git.
NODE_ENV=development
PORT=4000
# اختياري: مسار ملف JSON. الافتراضي ملف مؤقت داخل مجلد النظام المؤقت.
TEMP_DATA_FILE=/tmp/world-chaos-data.json
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=30d
CORS_ORIGINS=http://localhost:4000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_MESSAGES=8
RATE_LIMIT_MAX_DRAWINGS=4
MAX_DRAWING_BYTES=1500000
