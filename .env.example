# انسخ إلى .env وضع بيانات MySQL الحقيقية. لا ترفع .env إلى Git.
NODE_ENV=development
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=worldchaos
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_NAME=worldchaos
DB_POOL_SIZE=8
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=30d
CORS_ORIGINS=http://localhost:4000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_MESSAGES=8
RATE_LIMIT_MAX_DRAWINGS=4
MAX_DRAWING_BYTES=1500000
